# Google / YouTube OAuth
OAUTH_CLIENT_FILE=path/to/oauth_client.json
TOKEN_FILE=path/to/token.json
BQ_PROJECT=your-gcp-project-id
BQ_DATASET=raw_youtube
BQ_TABLE=raw_video_daily_metrics
YOUTUBE_START_DATE=2022-01-01
YOUTUBE_MODE=incremental

# Mailchimp
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_LIST_ID=your-list-id

# Stripe
STRIPE_API_KEY=your-stripe-api-key
BQ_DATASET_STRIPE=raw_stripe

# WooCommerce
WOOCOMMERCE_URL=https://your-site.com
WOOCOMMERCE_CONSUMER_KEY=your-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=your-consumer-secret
BQ_DATASET_WOOCOMMERCE=raw_woocommerce

# JotForm
JOTFORM_API_KEY=your-jotform-api-key
JOTFORM_FORM_ID_STANDARD=your-form-id
JOTFORM_FORM_ID_MANUAL_OPT=your-form-id
BQ_DATASET_JOTFORM=raw_jotform

# Spotify
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_SHOW_ID_MIC=your-show-id
SPOTIFY_SHOW_ID_INNER_WORK=your-show-id
BQ_DATASET_SPOTIFY=raw_spotify